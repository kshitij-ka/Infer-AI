# Application
APP_NAME=Infer AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security
JWT_SECRET_KEY=change-later
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database (also used by docker-compose.yml to provision the postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=qa_api
DATABASE_URL=postgresql+psycopg2://postgres:change-me-to-a-random-password@postgres:5432/qa_api

# Redis (also used by docker-compose.yml to require auth on the redis container)
REDIS_PASSWORD=change-me-to-a-random-password
REDIS_URL=redis://:change-me-to-a-random-password@redis:6379/0

# LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
IP_ONLY_LOGIN_RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=300
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_BYTES=65536
